# MCP Server
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
API_KEY=change-me-to-a-secure-random-key

# PostgreSQL (existing instance; empty database before first `alembic upgrade head`)
DATABASE_URL=postgresql://user:password@localhost:5432/openclaw_docs

# Ingestion (English documentation only)
DOCS_BASE_URL=https://docs.openclaw.ai
DOCS_LOCALES=en
INGEST_CONCURRENCY=5
INGEST_RATE_LIMIT_MS=200

# RAG / Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHUNK_MIN_SIZE=100

# OpenAI Embeddings
OPENAI_API_KEY=sk-your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Search (hybrid vector + full-text)
SEARCH_DEFAULT_LIMIT=8
SEARCH_MIN_SCORE=0.0
HYBRID_SEARCH=true

# Auto-sync (systemd timer reads these)
SYNC_ENABLED=true
SYNC_SCHEDULE=daily
